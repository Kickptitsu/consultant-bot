# Скопируйте этот файл в .env и подставьте свои значения.

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Telegram ID администраторов через запятую (свой ID можно узнать у @userinfobot).
# Им доступны /kb (база знаний) и загрузка файлов базы.
ADMIN_IDS=111111111,222222222

# Группа операторов: сюда приходят вопросы, на которые ИИ не ответил, и вызовы
# «🧑‍🔧 Позвать оператора». Как получить ID: создайте группу, добавьте в неё бота
# и операторов, напишите в группе /chat_id (от имени администратора из ADMIN_IDS).
# Пусто — передача оператору выключена, бот предлагает клиенту позвонить.
OPERATORS_CHAT_ID=

# Файл базы данных и папка базы знаний (необязательно)
DB_PATH=consultant.db
KNOWLEDGE_DIR=knowledge

# Ссылка на опубликованную политику обработки персональных данных (шаблон — PRIVACY.md).
# Пока пусто, бот присылает клиенту сам файл PRIVACY.md.
PRIVACY_POLICY_URL=

# ---------- ИИ ----------
# Кто отвечает клиентам:
#   demo     — без ИИ: бот показывает подходящий раздел базы знаний (ключ не нужен)
#   yandex   — YandexGPT (Yandex AI Studio)
#   gigachat — GigaChat (Сбер)
AI_PROVIDER=demo

# YandexGPT: ключ API сервисного аккаунта и ID каталога (см. README → «Подключение YandexGPT»)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель (необязательно). По умолчанию yandexgpt-5.1 (YandexGPT Pro 5.1)
YANDEX_MODEL=

# GigaChat: «ключ авторизации» из личного кабинета (строка Base64, не Client Secret)
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — для физлиц, GIGACHAT_API_B2B / GIGACHAT_API_CORP — для компаний
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель (необязательно). По умолчанию GigaChat-3-Lightning — на тестах точнее и дешевле GigaChat-2
GIGACHAT_MODEL=
# Сертификат Минцифры: им подписаны серверы GigaChat, а Windows его не знает.
# Файл уже в проекте (скачан с gosuslugi.ru/crt). Пусто — только сертификаты Windows.
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem
